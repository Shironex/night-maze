<rml>
<head>
    <title>Pause</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body>
<div id="panel">
    <h1>Paused</h1>
    <p>Escape goes back to the game.</p>
    <button data-action="resume">Resume</button>
    <button data-action="restart">Restart</button>
    <button data-action="menu">Back to menu</button>
</div>
</body>
</rml>
