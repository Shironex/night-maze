<rml>
<head>
    <title>Round end</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body>
<div id="panel">
    <h1>You escaped</h1>
    <!-- The two numbers are written by the game when the screen comes up
         (NightMazeApp::fillRoundEndDocument). -->
    <p>Time: <span id="time">0:00</span></p>
    <p>Crystals: <span id="crystals">0 / 0</span></p>
    <button data-action="restart">Restart</button>
    <button data-action="menu">Back to menu</button>
</div>
</body>
</rml>
