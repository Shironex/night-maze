<rml>
<head>
    <title>Main menu</title>
    <link type="text/rcss" href="menu.rcss"/>
</head>
<body class="left">
<!-- A button names what it does with data-action: the game turns the name into an event
     (game::eventForAction) or into a command of this screen (NightMazeApp). The elements
     with an id are written by the game: the label of the first entry, the night beside
     it, the day beside "Tonight's hedge" and the numbers of the info block. -->
<!-- The black the menu comes out of when it follows the intro or the ending card. The
     game sets the class "drawn" on it then. -->
<div class="curtain" id="curtain"></div>
<div class="column">
    <div class="rise">
        <div class="gem"></div>
        <h1 class="wordmark">NIGHT MAZE</h1>
        <p class="subtitle">The Last Lamp</p>
        <p class="tagline">The moon sees every corridor. You see one.</p>
    </div>
    <div class="menu long">
        <div class="rise d1">
            <!-- The campaign: "Begin" before a night is won, "Continue" with the next
                 night beside it, "New campaign" once the last night is won. The label
                 is an element of its own, so writing it leaves the marker bar alone. -->
            <div class="entry">
                <button class="item" id="campaign" data-action="campaign" autofocus><div class="bar"></div><span id="campaign-label">Begin</span></button>
                <span class="beside" id="campaign-night"></span>
            </div>
        </div>
        <!-- The list of the five nights. It is always there: before a night is won it
             shows the first night as the next one. -->
        <div class="rise d2">
            <button class="item" id="open-nights" data-action="nights"><div class="bar"></div>Nights</button>
        </div>
        <!-- The lamplighter's ledger: every line of the story that was read. -->
        <div class="rise d3">
            <button class="item" id="open-ledger" data-action="ledger"><div class="bar"></div>Ledger</button>
        </div>
        <!-- The maze of the day, the same one for every player: its day stands beside
             it, and the best time of the day once it has one. -->
        <div class="rise d4">
            <div class="entry">
                <button class="item" id="open-daily" data-action="daily"><div class="bar"></div>Tonight's hedge</button>
                <span class="beside" id="daily-date"></span>
            </div>
        </div>
        <div class="rise d5">
            <button class="item" id="open-free-play" data-action="free-play"><div class="bar"></div>Free play</button>
        </div>
        <div class="rise d6">
            <button class="item" id="open-settings" data-action="settings"><div class="bar"></div>Settings</button>
        </div>
        <div class="rise d7">
            <button class="item" id="quit" data-action="quit"><div class="bar"></div>Quit</button>
        </div>
    </div>
</div>
<!-- The numbers of the night the first entry starts. -->
<div class="info rise d8">
    <div class="fact">
        <p class="fact-name">Maze</p>
        <p class="fact-value" id="info-maze">10 x 10</p>
    </div>
    <div class="fact">
        <p class="fact-name">Crystals to find</p>
        <p class="fact-value" id="info-crystals">10 of 13</p>
    </div>
    <div class="fact">
        <p class="fact-name">Battery</p>
        <p class="fact-value" id="info-battery">3:00</p>
    </div>
</div>
<p class="keys corner">Arrows or Tab: move | Enter: choose</p>
</body>
</rml>
