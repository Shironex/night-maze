---
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '../styles/site.css';

const base = import.meta.env.BASE_URL;
const page = new URL(base, Astro.site).href;
const share = new URL(`${base}img/og.jpg`, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Night Maze: The Last Lamp</title>
<meta name="description" content="A first person maze game for Windows, written without a game engine in C++20 and OpenGL 4.1. Free, and made by one person.">
<meta name="theme-color" content="#070b16">
<link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml">
<link rel="canonical" href={page}>
<meta property="og:type" content="website">
<meta property="og:title" content="Night Maze: The Last Lamp">
<meta property="og:description" content="The moon sees every corridor. You see one. A free first person maze game for Windows, written without a game engine.">
<meta property="og:url" content={page}>
<meta property="og:image" content={share}>
<meta property="og:image:width" content="1280">
<meta property="og:image:height" content="640">
<meta name="twitter:card" content="summary_large_image">
</head>
<body>
<slot />
<audio id="theme" loop preload="none" src={`${base}media/menu-theme.mp3`}></audio>
<script>
  import '../scripts/page.ts';
</script>
</body>
</html>
